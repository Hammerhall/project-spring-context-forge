#!/usr/bin/env bash
# ============================================================
#  Hammerhall CLI — обёртка-загрузчик.
#
#  В репозитории лежит только этот скрипт. Сам клиент (cli.jar)
#  скачивается при первом запуске в .hammerhall/ — папку, которая
#  в .gitignore.
#
#  Почему не коммитить jar: бинарник остаётся в истории git НАВСЕГДА,
#  и каждая новая версия добавляет мегабайты. Через год клонирование
#  кузницы качало бы десяток мёртвых версий клиента.
#
#  ── Как приезжает обновление ────────────────────────────────
#  Версия закреплена ЗДЕСЬ, и это и есть механизм. Имя файла
#  содержит версию, поэтому при её подъёме обёртка не находит jar
#  и качает новый. То есть обновление доезжает вместе с `git pull`
#  кузницы — отдельного канала не нужно.
#
#  Отсюда правило: НИКОГДА не перевыкладывать один и тот же номер
#  версии с другим содержимым. Файл называется так же, обёртка
#  считает, что клиент уже скачан, и человек навсегда остаётся со
#  старым. Ровно на это мы потеряли час 24.07.
#
#  `hammerhall update` — принудительно перекачать. Нужен, когда
#  скачанный файл побился или когда версию всё-таки перевыложили.
#  Живёт в обёртке, а не в клиенте, по двум причинам: версию знает
#  обёртка, и на Windows запущенный jar заблокирован — сам себя
#  клиент заменить не может.
# ============================================================
set -euo pipefail

VERSION="0.1.4"
REPO="hammerhall/hammerhall-cli"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="$ROOT/.hammerhall"
JAR="$DIR/cli-$VERSION.jar"
URL="https://github.com/$REPO/releases/download/v$VERSION/cli-$VERSION.jar"

if ! command -v java > /dev/null 2>&1; then
    echo "Нужна Java. Она же нужна, чтобы решать задачи — поставьте JDK 25." >&2
    exit 1
fi

download() {
    echo "Загружаю клиент $VERSION…" >&2
    mkdir -p "$DIR"

    # Во временный файл, потом переименование: оборвётся связь на середине —
    # останется мусор с временным именем, а не битый jar под правильным.
    # Иначе следующий запуск решил бы, что клиент уже скачан.
    TMP="$JAR.part"
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$TMP" "$URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$TMP" "$URL"
    else
        echo "Нужен curl или wget." >&2
        exit 1
    fi
    mv "$TMP" "$JAR"

    # Прошлые версии больше не нужны: обёртка запускает только свою.
    # Без уборки .hammerhall/ копит мегабайты мёртвых клиентов.
    find "$DIR" -maxdepth 1 -name 'cli-*.jar' ! -name "cli-$VERSION.jar" -delete 2>/dev/null || true
}

# `update` перехватывается ДО запуска JVM: иначе на Windows пришлось бы
# перезаписывать jar, который прямо сейчас выполняется, а он заблокирован.
if [[ "${1:-}" == "update" ]]; then
    rm -f "$DIR"/cli-*.jar "$DIR"/*.part
    download
    echo "Клиент обновлён до $VERSION." >&2
    exit 0
fi

if [[ ! -f "$JAR" ]]; then
    download
fi

exec java -jar "$JAR" "$@"
